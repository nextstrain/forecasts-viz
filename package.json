{
  "name": "@nextstrain/evofr-viz",
  "version": "0.2.0",
  "description": "React components for visualising evofr model JSONs",
  "private": true,
  "type": "module",
  "author": "Nextstrain",
  "license": "AGPL-3.0-only",
  "repository": "github:nextstrain/forecasts-viz",
  "homepage": "https://nextstrain.github.io/forecasts-viz",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "download": "bash ./scripts/download-data.sh",
    "dev:local": "concurrently \"node scripts/data-server.js\" \"VITE_CLADES_RENEWAL='http://localhost:8000/clades.renewal.json' VITE_CLADES_MLR='http://localhost:8000/clades.mlr.json' VITE_LINEAGES_MLR='http://localhost:8000/lineages.mlr.json' vite\"",
    "test": "node src/tests/date-parsing.ts",
    "typecheck": "tsc",
    "docs": "jsdoc2md src/lib/index.js src/lib/**/*.js > api.md",
    "prepack": "npm run build:lib"
  },
  "files": [
    "dist",
    "api.md",
    "README.md"
  ],
  "peerDependencies": {
    "d3": ">=7",
    "rc-switch": ">=4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "usehooks-ts": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "argparse": "^2.0.1",
    "concurrently": "^8.2.0",
    "d3": ">=7",
    "express": "^4.18.2",
    "gh-pages": "^5.0.0",
    "jsdoc": "^4.0.0",
    "jsdoc-to-markdown": "^8.0.0",
    "puppeteer": "^19.4.0",
    "rc-switch": ">=4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-tabs": "^4.3.0",
    "typescript": "^6.0.3",
    "usehooks-ts": "^2.9.1",
    "vite": "^5.4.0"
  }
}
